# --- Database -------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/courses

# --- Paystack -------------------------------------------------------------
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_BASE_URL=https://api.paystack.co

# Bound every external call. A timeout is NOT a failure - it is an *unknown*
# outcome, which is why we also reconcile.
PAYSTACK_TIMEOUT_SECONDS=10
PAYSTACK_MAX_RETRIES=2

# --- Connection pool bounds (so a Paystack stall can't exhaust the pool) ---
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=10

# --- Reconciliation -------------------------------------------------------
# Give the webhook + callback a head-start before the poller touches a payment.
RECONCILE_MIN_AGE_SECONDS=120
RECONCILE_INTERVAL_SECONDS=300
RECONCILE_BATCH_SIZE=100
# A pending payment older than this that Paystack has no record of is abandoned.
RECONCILE_ABANDON_AFTER_SECONDS=3600

# --- App ------------------------------------------------------------------
PUBLIC_BASE_URL=http://localhost:8000
# Run the reconciliation loop inside the API process (fine for a demo; in
# production run `python -m jobs.reconcile` as its own worker instead).
RUN_RECONCILE_IN_PROCESS=false
